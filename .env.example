DATABASE_URL=postgresql+psycopg://achados:achados@localhost:5432/achados

# Só para o docker compose (o contêiner `app` usa o serviço `db`, ignorando DATABASE_URL acima)
# POSTGRES_PASSWORD=troque-isto

# Shopee Affiliate Open API (painel de afiliados Shopee > Open API)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Opcional: proxy para o Mercado Livre (IP de datacenter costuma ser bloqueado)
# ML_PROXY_URL=http://usuario:senha@host:porta

# Mercado Livre API oficial (developers.mercadolivre.com.br/devcenter) - fluxo client_credentials
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Serviço (docker compose up -d): API e coleta agendada
# Obrigatório para usar /api/*. Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# COLLECT_ENABLED=true
# COLLECT_INTERVAL_SECONDS=21600   # 6h
# COLLECT_PRESET=bjj
# SHOPEE_COLLECT_ENABLED=true   # com SHOPEE_APP_ID e SHOPEE_SECRET preenchidos, a coleta da Shopee roda sozinha
# SHOPEE_COLLECT_INTERVAL_SECONDS=21600   # 6h
# LINK_MIN_SCORE=60   # só ofertas do ML com pontuação >= isto entram na fila de links (0 = todas)
# Robô de envio ao WhatsApp (opcional; ver README). Número DEDICADO, nunca o seu pessoal.
# COMPOSE_PROFILES=sender
# SENDER_URL=http://sender:3000
# SENDER_TOKEN=   # gere como o ADMIN_TOKEN; vale para o app e para o contêiner sender
# SENDER_DAILY_CAP=30   # mensagens por dia (cada grupo conta uma)
# SENDER_MIN_DELAY_SECONDS=60
# SENDER_MAX_DELAY_SECONDS=180
# SENDER_WINDOW_START_HOUR=8   # só envia nesta janela (Brasília)
# SENDER_WINDOW_END_HOUR=22
# LOG_LEVEL=INFO   # DEBUG mostra mais; as requisições HTTP do httpx ficam sempre silenciadas
